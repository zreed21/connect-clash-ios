{
  "appId": "com.connectclash.app",
  "appName": "Pairstorm",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0614",
    "preferredContentMode": "mobile",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0a0614",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0614",
      "overlaysWebView": true
    }
  }
}
